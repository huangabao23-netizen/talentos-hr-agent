# TalentOS environment configuration
# Copy this file to `.env`, then fill in local secrets.
# Do not commit `.env` because it contains API keys.

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------

# Select the model provider used by JD generation, resume parsing, scoring, and
# interview question generation.
# Supported values:
# - groq
# - minimax
LLM_PROVIDER=minimax

# -----------------------------------------------------------------------------
# MiniMax provider, using Anthropic-compatible SDK endpoint
# -----------------------------------------------------------------------------

# MiniMax API key. Supports the `sk-api-*` or `sk-cp-*` key issued by MiniMax.
# Required when LLM_PROVIDER=minimax.
MINIMAX_API_KEY=

# MiniMax model name. Current tested default:
# - MiniMax-M3
MINIMAX_MODEL=MiniMax-M3

# MiniMax Anthropic-compatible endpoint used by the anthropic Python SDK.
# Normally you do not need to change this.
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# Backward-compatible alias. If ANTHROPIC_BASE_URL is empty, code can fall back
# to this value.
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# -----------------------------------------------------------------------------
# Groq provider
# -----------------------------------------------------------------------------

# Groq API key. Required when LLM_PROVIDER=groq.
GROQ_API_KEY=

# Groq model name. Current tested default:
# - llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Optional tracing
# -----------------------------------------------------------------------------

# Optional LangSmith API key. Leave empty unless you want tracing.
LANGCHAIN_API_KEY=

# LangSmith project name for trace grouping.
LANGCHAIN_PROJECT=talentos-hr-agent

# Enable or disable LangSmith tracing when LANGCHAIN_API_KEY is set.
LANGCHAIN_TRACING_V2=true

# -----------------------------------------------------------------------------
# Local storage
# -----------------------------------------------------------------------------

# SQLite database path. Relative paths are resolved from the project root.
# Default used by the app if unset:
# data/talentos.db
TALENTOS_DB_PATH=data/talentos.db

# Directory for generated or uploaded runtime data.
TALENTOS_DATA_DIR=data

# -----------------------------------------------------------------------------
# Local matching / embeddings
# -----------------------------------------------------------------------------

# SentenceTransformer model used for local skill similarity signal.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Enable local embedding similarity signal for scoring.
# Supported values: true / false
ENABLE_EMBEDDING_SIGNAL=true

# -----------------------------------------------------------------------------
# Open-source sourcing APIs
# -----------------------------------------------------------------------------

# Optional GitHub personal access token. The app can call public GitHub Search
# API without it, but a token raises rate limits.
GITHUB_TOKEN=

# Google Scholar has no official public API. Configure one of the supported
# third-party providers below. GOOGLE_SCHOLAR_PROVIDER can be:
# auto / serpapi / serpdog / scrapingbee
GOOGLE_SCHOLAR_PROVIDER=auto

# SerpAPI Google Scholar key.
SERPAPI_API_KEY=

# SerpDog Google Scholar key.
SERPDOG_API_KEY=

# ScrapingBee Google Scholar key.
SCRAPINGBEE_API_KEY=

# -----------------------------------------------------------------------------
# Company People / ATS talent pool APIs
# -----------------------------------------------------------------------------

# Base URL of the company People / ATS API. Leave empty to disable this connector.
# Example: https://people-api.company.com
PEOPLE_API_BASE_URL=

# API token or service token for the People system.
PEOPLE_API_TOKEN=

# Header used for token auth. Most systems use Authorization.
PEOPLE_API_AUTH_HEADER=Authorization

# Token prefix. Common values: Bearer / Token. Leave empty if the token should be
# sent without a prefix.
PEOPLE_API_TOKEN_PREFIX=Bearer

# Endpoint for searching talent records.
# Called as:
# GET {PEOPLE_API_BASE_URL}{PEOPLE_API_SEARCH_ENDPOINT}?q=...&department=...&location=...&limit=...
PEOPLE_API_SEARCH_ENDPOINT=/api/talents/search

# Endpoint for fetching one talent profile. `{people_id}` will be replaced.
PEOPLE_API_PROFILE_ENDPOINT=/api/talents/{people_id}

# Endpoint for fetching candidate process/status. `{people_id}` will be replaced.
PEOPLE_API_STATUS_ENDPOINT=/api/talents/{people_id}/status

# Timeout in seconds for People API calls.
PEOPLE_API_TIMEOUT=15

# -----------------------------------------------------------------------------
# Streamlit runtime
# -----------------------------------------------------------------------------

# Host and port for local Streamlit startup scripts or manual use.
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8501

# Streamlit browser telemetry toggle.
STREAMLIT_GATHER_USAGE_STATS=false
